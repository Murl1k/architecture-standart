@startuml c4-components
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.14.0/C4_Component.puml

title передача ставок в кол-центры: диаграмма компонентов

Person(operator, "оператор кол-центра")
Person_Ext(partner_operator, "оператор партнерского кол-центра")

ContainerDb(abs_db, "БД АБС", "oracle, pl/sql", "справочник ставок, исходящие события")
ContainerQueue(kafka, "kafka", "kafka", "топик ставок")
Container(sftp, "sftp-сервер банка", "sftp", "отдельная папка партнера, доступ по ключу")
System_Ext(partner, "система партнерского кол-центра")

Container_Boundary(abs_integration, "сервис интеграции депозитов, java spring boot") {
    Component(rates_publisher, "публикатор ставок", "spring boot", "читает события о новых ставках и публикует ставки в kafka, есть в ADR1")
    Component(file_builder, "формирователь файла ставок", "spring boot", "собирает csv с общими ставками и датой актуальности после каждой публикации")
    Component(sftp_client, "sftp-клиент", "spring boot", "кладет файл в папку партнера, повторяет отправку при ошибке")
}

System_Boundary(callcenter, "система кол-центра") {
    Container(cc_ui, "интерфейс оператора", "react.js", "новый раздел ставок со временем обновления")
    Container_Boundary(rates_svc, "сервис ставок, java spring boot") {
        Component(rates_consumer, "приемник ставок", "spring boot", "читает топик ставок")
        Component(rates_repo, "хранилище ставок", "spring boot", "сохраняет последнюю версию ставок и время обновления")
        Component(rates_api, "api ставок", "spring boot", "отдает ставки интерфейсу оператора")
    }
    ContainerDb(cc_db, "БД системы кол-центра", "postgresql", "новая таблица ставок")
}

Rel(rates_publisher, abs_db, "читает события о ставках", "jdbc")
Rel(rates_publisher, kafka, "публикует ставки", "kafka")
Rel(file_builder, kafka, "читает ставки", "kafka")
Rel(file_builder, sftp_client, "готовый файл")
Rel(sftp_client, sftp, "загружает файл", "sftp")
Rel(partner, sftp, "забирает файл", "sftp")
Rel(partner_operator, partner, "смотрит ставки")

Rel(rates_consumer, kafka, "читает ставки", "kafka")
Rel(rates_consumer, rates_repo, "новые ставки")
Rel(rates_api, rates_repo, "текущие ставки")
Rel(rates_repo, cc_db, "читает и пишет", "jdbc")
Rel(cc_ui, rates_api, "запрашивает ставки", "https, rest")
Rel(operator, cc_ui, "смотрит ставки")

SHOW_LEGEND()
@enduml
